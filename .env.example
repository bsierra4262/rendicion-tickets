# ============================================================
#  Variables de entorno (Docker / 12-factor).
#  Copiá este archivo a .env y completá los valores.
#  .env NO se versiona (contiene secretos).
# ============================================================

# ---- Puerto público del contenedor de la app ----
APP_PORT=8080

# ---- Base de datos ----
DB_HOST=db
DB_NAME=tickets
DB_USER=tickets
DB_PASS=cambia-esta-clave
DB_ROOT_PASS=cambia-esta-clave-root
DB_CHARSET=utf8mb4

# ---- Aplicación ----
APP_NAME=Rendición de Tickets
APP_ORG=TU_ORGANIZACION
APP_BASE_PATH=
APP_ENV=prod
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_SECRET=generar-un-secret-aleatorio-largo
APP_IDLE_TTL=600
APP_ABS_TTL=28800

# ---- White-label (opcional) ----
APP_BRAND_PRIMARY=
APP_BRAND_ACCENT=
APP_BRAND_LOGO=

# ---- Google OAuth (login + respaldo en Drive) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=
GOOGLE_AUTO_PROVISION=true
