# ============================================================
#  App INTELLIHELP · Rendición de comprobantes  ·  /comprobantes/
#  Aísla esta carpeta del WordPress + Wordfence del raíz.
# ============================================================

# Desactivar el WAF de Wordfence (auto_prepend_file del raíz) para esta app
php_value auto_prepend_file none

# Config y storage seguros (fuera del web root)
SetEnv TICKETS_CONFIG /home/u566451014/tickets_config/config.php
SetEnv TICKETS_STORAGE /home/u566451014/tickets_storage

DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /comprobantes/

    # Servir archivos y carpetas reales tal cual (assets, uploads, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demás -> front controller
    RewriteRule ^([A-Za-z0-9/_-]*)$ index.php?r=$1 [L,QSA]
</IfModule>

# Proteger archivos sensibles
<FilesMatch "\.(sql|md|json|lock|log)$">
    Require all denied
</FilesMatch>

# ---- Performance ----
# Compresión de texto (páginas, CSS, JS, JSON, SVG): menos bytes, carga más rápida.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caché larga para assets (CSS/JS van versionados con ?v=, así que es seguro y "immutable";
# imágenes/fuentes/modelos ONNX no cambian). Repetir visitas = instantáneo.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?|ttf|otf|eot|png|jpe?g|gif|svg|webp|ico|onnx)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
</IfModule>
